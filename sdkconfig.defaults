# Valores por defecto para la placa Waveshare ESP32-S3-LCD-1.54 (N16R8).
# Se aplican la primera vez que se genera "sdkconfig". Si cambias algo aquí,
# borra "sdkconfig" (o ejecuta "idf.py fullclean") para que se vuelva a leer.
CONFIG_IDF_TARGET="esp32s3"

# Flash de 16 MB
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# PSRAM octal de 8 MB
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# CPU a 240 MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# FreeRTOS a 1000 Hz: vTaskDelay(pdMS_TO_TICKS(1)) = 1 ms
CONFIG_FREERTOS_HZ=1000

# Nombres largos de fichero en la microSD
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
