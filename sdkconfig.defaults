# Defaults for the Waveshare ESP32-S3-LCD-1.54 (N16R8).
# Existing sdkconfig values take precedence. To regenerate from these defaults,
# move the existing sdkconfig aside and run idf.py reconfigure.
CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 8 MB octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# 240 MHz CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 1 kHz FreeRTOS tick rate
CONFIG_FREERTOS_HZ=1000

# Long filenames on microSD
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
